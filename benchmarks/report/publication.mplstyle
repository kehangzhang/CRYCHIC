figure.dpi: 120
savefig.dpi: 300
savefig.bbox: tight
savefig.facecolor: white
figure.facecolor: white
axes.facecolor: white
font.family: sans-serif
font.sans-serif: DejaVu Sans, Arial, Liberation Sans
font.size: 8
axes.titlesize: 9
axes.labelsize: 8
axes.titleweight: bold
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False
xtick.labelsize: 7
ytick.labelsize: 7
xtick.major.width: 0.7
ytick.major.width: 0.7
xtick.major.size: 3
ytick.major.size: 3
legend.fontsize: 7
legend.frameon: False
lines.linewidth: 1.2
lines.markersize: 4
patch.linewidth: 0.7
grid.linewidth: 0.5
grid.alpha: 0.25
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
