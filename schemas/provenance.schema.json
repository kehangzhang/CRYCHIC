{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crychic:schema:provenance:0.1.0",
  "title": "CRYCHIC run provenance",
  "description": "Minimum Phase 0 provenance attached to persisted artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "package_version",
    "git_commit",
    "git_dirty",
    "config_digest",
    "input_digest",
    "resource_digests",
    "result_schema_version",
    "seed_lineage"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "git_commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "git_dirty": {
      "type": "boolean"
    },
    "config_digest": {
      "$ref": "#/$defs/sha256"
    },
    "input_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "resource_digests": {
      "type": "object",
      "propertyNames": {
        "pattern": "^\\S(?:.*\\S)?$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "result_schema_version": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "seed_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_seed", "path", "derived_seed"],
      "properties": {
        "root_seed": {
          "$ref": "#/$defs/seed"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$"
          }
        },
        "derived_seed": {
          "$ref": "#/$defs/seed"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  }
}
