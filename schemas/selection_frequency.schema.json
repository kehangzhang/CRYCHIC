{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crychic:schema:extension:selection-frequency:1.0.0",
  "title": "CRYCHIC authenticated family selection-frequency table",
  "type": "object",
  "additionalProperties": false,
  "required": ["extension_schema_version", "result_schema_version", "table", "filename", "primary_key", "linked_tables", "columns"],
  "properties": {
    "extension_schema_version": {"const": "1.0.0"},
    "result_schema_version": {"const": "0.1.0"},
    "table": {"const": "selection_frequency"},
    "filename": {"const": "selection_frequency.parquet"},
    "primary_key": {"const": ["hypothesis_level", "hypothesis_id", "contrast", "mode", "view"]},
    "linked_tables": {"const": ["differential"]},
    "columns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_level", "hypothesis_role", "hypothesis_id", "contrast", "mode", "view", "receiver", "family_id",
        "selection_frequency", "status", "reason_code", "opportunity_grain", "selection_frequency_semantics", "minimum_bootstraps",
        "n_bootstrap_plans_total", "n_bootstrap_plans_observed", "n_bootstrap_plans_not_estimable", "n_bootstrap_plans_failed",
        "n_event_rows_total", "n_observed_event_rows", "n_not_estimable_event_rows", "n_failed_event_rows", "n_selected_event_rows",
        "result_id", "target_id", "declaration_id", "hypothesis_universe_id", "crossfit_spec_id", "resampling_result_id",
        "source_resampled_attribution_collection_id", "source_binding_id", "selection_frequency_spec_id", "numeric_result_id",
        "bootstrap_plan_set_id", "opportunity_manifest_id", "selection_rule_id", "selection_rule_semantics", "selection_threshold", "score_version", "source_record_set_id",
        "source_authenticated", "source_binding_status", "authentication_semantics", "exact_plan_coverage", "exact_fold_coverage", "complete_universe_coverage",
        "selection_frequency_release_allowed", "formal_pq_inference_allowed", "is_posterior_probability", "is_comm_probability"
      ],
      "properties": {
        "hypothesis_level": {"dtype": "string", "nullable": false, "enum": ["driver_family_receiver"], "unit": null, "description": "Family-by-receiver selection target"},
        "hypothesis_role": {"dtype": "string", "nullable": false, "enum": ["primary"], "unit": null, "description": "Hierarchical hypothesis role"},
        "hypothesis_id": {"$ref": "#/$defs/stringRequired"},
        "contrast": {"$ref": "#/$defs/stringRequired"},
        "mode": {"dtype": "string", "nullable": false, "enum": ["state"], "unit": null, "description": "Released v1 selection estimand"},
        "view": {"dtype": "string", "nullable": false, "enum": ["gene"], "unit": null, "description": "Released v1 response view"},
        "receiver": {"$ref": "#/$defs/stringRequired"},
        "family_id": {"$ref": "#/$defs/stringRequired"},
        "selection_frequency": {"$ref": "#/$defs/unitIntervalNullable"},
        "status": {"$ref": "#/$defs/supportStatus"},
        "reason_code": {"$ref": "#/$defs/stringNullable"},
        "opportunity_grain": {"dtype": "string", "nullable": false, "enum": ["equal_bootstrap_mean_of_outer_fold_selection_v1"], "unit": null, "description": "Equal plan then equal outer-fold grain"},
        "selection_frequency_semantics": {"$ref": "#/$defs/stringRequired"},
        "minimum_bootstraps": {"dtype": "integer", "nullable": false, "minimum": 1000, "maximum": 1000, "unit": "bootstrap plans", "description": "Fixed minimum plan count"},
        "n_bootstrap_plans_total": {"$ref": "#/$defs/count"},
        "n_bootstrap_plans_observed": {"$ref": "#/$defs/count"},
        "n_bootstrap_plans_not_estimable": {"$ref": "#/$defs/count"},
        "n_bootstrap_plans_failed": {"$ref": "#/$defs/count"},
        "n_event_rows_total": {"$ref": "#/$defs/count"},
        "n_observed_event_rows": {"$ref": "#/$defs/count"},
        "n_not_estimable_event_rows": {"$ref": "#/$defs/count"},
        "n_failed_event_rows": {"$ref": "#/$defs/count"},
        "n_selected_event_rows": {"$ref": "#/$defs/count"},
        "result_id": {"$ref": "#/$defs/stringRequired"},
        "target_id": {"$ref": "#/$defs/stringNullable"},
        "declaration_id": {"$ref": "#/$defs/stringRequired"},
        "hypothesis_universe_id": {"$ref": "#/$defs/stringRequired"},
        "crossfit_spec_id": {"$ref": "#/$defs/stringRequired"},
        "resampling_result_id": {"$ref": "#/$defs/stringRequired"},
        "source_resampled_attribution_collection_id": {"$ref": "#/$defs/stringNullable"},
        "source_binding_id": {"$ref": "#/$defs/stringNullable"},
        "selection_frequency_spec_id": {"$ref": "#/$defs/stringNullable"},
        "numeric_result_id": {"$ref": "#/$defs/stringNullable"},
        "bootstrap_plan_set_id": {"$ref": "#/$defs/stringNullable"},
        "opportunity_manifest_id": {"$ref": "#/$defs/stringNullable"},
        "selection_rule_id": {"$ref": "#/$defs/stringNullable"},
        "selection_rule_semantics": {"$ref": "#/$defs/stringNullable"},
        "selection_threshold": {"$ref": "#/$defs/floatNullable"},
        "score_version": {"$ref": "#/$defs/stringNullable"},
        "source_record_set_id": {"$ref": "#/$defs/stringNullable"},
        "source_authenticated": {"$ref": "#/$defs/trueBoolean"},
        "source_binding_status": {"$ref": "#/$defs/stringRequired"},
        "authentication_semantics": {"$ref": "#/$defs/stringRequired"},
        "exact_plan_coverage": {"$ref": "#/$defs/trueBoolean"},
        "exact_fold_coverage": {"$ref": "#/$defs/trueBoolean"},
        "complete_universe_coverage": {"$ref": "#/$defs/trueBoolean"},
        "selection_frequency_release_allowed": {"dtype": "boolean", "nullable": false, "unit": null, "description": "Component-specific release decision"},
        "formal_pq_inference_allowed": {"$ref": "#/$defs/falseBoolean"},
        "is_posterior_probability": {"$ref": "#/$defs/falseBoolean"},
        "is_comm_probability": {"$ref": "#/$defs/falseBoolean"}
      }
    }
  },
  "$defs": {
    "stringRequired": {"dtype": "string", "nullable": false, "unit": null, "description": "Stable non-empty value"},
    "stringNullable": {"dtype": "string", "nullable": true, "unit": null, "description": "Optional lineage or reason"},
    "floatNullable": {"dtype": "float", "nullable": true, "unit": null, "description": "Optional fixed numeric contract"},
    "unitIntervalNullable": {"dtype": "float", "nullable": true, "minimum": 0.0, "maximum": 1.0, "unit": "frequency", "description": "Equal-bootstrap selection frequency"},
    "count": {"dtype": "integer", "nullable": false, "minimum": 0, "unit": "rows", "description": "Non-negative count"},
    "supportStatus": {"dtype": "string", "nullable": false, "enum": ["observed", "not_estimable", "failed"], "unit": null, "description": "Component availability"},
    "trueBoolean": {"dtype": "boolean", "nullable": false, "enum": [true], "unit": null, "description": "Must be true"},
    "falseBoolean": {"dtype": "boolean", "nullable": false, "enum": [false], "unit": null, "description": "Must be false"}
  }
}
