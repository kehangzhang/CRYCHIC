{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crychic:schema:table:signatures:0.1.0",
  "title": "CRYCHIC v0.1 signatures table",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_schema_version", "table", "filename", "primary_key", "columns", "inferential_null_columns", "reason_required_for_null_columns"],
  "properties": {
    "result_schema_version": {"const": "0.1.0"},
    "table": {"const": "signatures"},
    "filename": {"const": "signatures.parquet"},
    "primary_key": {
      "const": ["context_id", "sender_id", "receiver", "interaction_id", "gene", "view"]
    },
    "inferential_null_columns": {"const": []},
    "reason_required_for_null_columns": {
      "const": ["observed", "predicted", "residual", "weight", "stability"]
    },
    "columns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "context_json", "sender_id", "receiver", "interaction_id", "gene", "view", "direction", "observed", "predicted", "residual", "weight", "stability", "status", "reason_code"],
      "properties": {
        "context_id": {"$ref": "#/$defs/stringRequired"},
        "context_json": {"$ref": "#/$defs/stringRequired"},
        "sender_id": {"$ref": "#/$defs/stringRequired"},
        "receiver": {"$ref": "#/$defs/stringRequired"},
        "interaction_id": {"$ref": "#/$defs/stringRequired"},
        "gene": {"$ref": "#/$defs/stringRequired"},
        "view": {"dtype": "string", "nullable": false, "enum": ["gene", "tf", "pathway"], "unit": null, "description": "Signature view"},
        "direction": {"dtype": "string", "nullable": false, "enum": ["positive", "negative", "neutral", "unknown"], "unit": null, "description": "Versioned contribution direction"},
        "observed": {"$ref": "#/$defs/floatNullable"},
        "predicted": {"$ref": "#/$defs/floatNullable"},
        "residual": {"$ref": "#/$defs/floatNullable"},
        "weight": {"$ref": "#/$defs/floatNullable"},
        "stability": {"dtype": "float", "nullable": true, "minimum": 0.0, "maximum": 1.0, "unit": "proportion", "description": "Selection stability"},
        "status": {"$ref": "#/$defs/status"},
        "reason_code": {"dtype": "string", "nullable": true, "unit": null, "description": "Missingness or eligibility reason"}
      }
    }
  },
  "$defs": {
    "stringRequired": {"dtype": "string", "nullable": false, "unit": null, "description": "Stable non-null identifier; use __all__ for aggregate scope"},
    "floatNullable": {"dtype": "float", "nullable": true, "unit": null, "description": "Nullable signature value"},
    "status": {"dtype": "string", "nullable": false, "enum": ["ok", "missing", "not_estimable", "filtered", "failed"], "unit": null, "description": "Explicit result status"}
  }
}
