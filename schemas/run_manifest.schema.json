{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crychic:schema:run-manifest:0.1.0",
  "title": "CRYCHIC v0.1 run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_schema_version",
    "run_id",
    "status",
    "mode",
    "created_at",
    "code_version",
    "config_digest",
    "workflow_parameters",
    "workflow_digest",
    "provenance_digest",
    "input_digest",
    "resource_digests",
    "tables",
    "stages",
    "warnings"
  ],
  "properties": {
    "result_schema_version": {"const": "0.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"const": "complete"},
    "mode": {"const": "exploratory"},
    "created_at": {"type": "string", "format": "date-time"},
    "code_version": {"type": "string", "minLength": 1},
    "config_digest": {"$ref": "#/$defs/sha256"},
    "workflow_parameters": {"type": "object"},
    "workflow_digest": {"$ref": "#/$defs/sha256"},
    "provenance_digest": {"$ref": "#/$defs/sha256"},
    "input_digest": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "resource_digests": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interactions",
        "differential",
        "responses",
        "sample_scores",
        "signatures"
      ],
      "properties": {
        "interactions": {"$ref": "#/$defs/tableRecord"},
        "differential": {"$ref": "#/$defs/tableRecord"},
        "responses": {"$ref": "#/$defs/tableRecord"},
        "sample_scores": {"$ref": "#/$defs/tableRecord"},
        "signatures": {"$ref": "#/$defs/tableRecord"}
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "reason_code"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["complete", "skipped", "failed", "not_estimable"]
          },
          "reason_code": {"type": ["string", "null"]}
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tableRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "rows", "sha256", "schema"],
      "properties": {
        "filename": {"type": "string", "pattern": "^[a-z_]+\\.parquet$"},
        "rows": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema": {"type": "string", "pattern": "^[a-z_]+\\.schema\\.json$"}
      }
    }
  }
}
