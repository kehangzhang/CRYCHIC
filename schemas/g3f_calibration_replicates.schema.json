{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crychic:schema:table:g3f-calibration-replicates:1.0.0",
  "title": "CRYCHIC G3-F calibration replicate registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_schema_version", "table", "filename", "primary_key", "logical_key", "foreign_keys", "columns"],
  "properties": {
    "artifact_schema_version": {"const": "1.0.0"},
    "table": {"const": "g3f_calibration_replicates"},
    "filename": {"const": "g3f_calibration_replicates.parquet"},
    "primary_key": {"const": ["replicate_id"]},
    "logical_key": {"const": ["dependence_structure", "non_null_prevalence", "replicate_index"]},
    "foreign_keys": {"const": [{"columns": ["protocol_id"], "references": "manifest.protocol_id"}]},
    "columns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicate_id", "protocol_id", "scenario_id", "dependence_structure", "non_null_prevalence", "replicate_index", "seed_lineage_json", "source_artifact_id", "status", "reason_code", "permutation_null_p_value", "n_hypotheses"],
      "properties": {
        "replicate_id": {"dtype": "string", "nullable": false},
        "protocol_id": {"dtype": "string", "nullable": false},
        "scenario_id": {"dtype": "string", "nullable": false},
        "dependence_structure": {"dtype": "string", "nullable": false, "enum": ["independent_hypotheses", "positive_within_family_block", "negative_within_family_block"]},
        "non_null_prevalence": {"dtype": "float", "nullable": true, "enum": [0.005, 0.01, 0.05, 0.1]},
        "replicate_index": {"dtype": "integer", "nullable": false, "minimum": 0},
        "seed_lineage_json": {"dtype": "string", "nullable": false, "encoding": "canonical_json"},
        "source_artifact_id": {"dtype": "string", "nullable": false},
        "status": {"dtype": "string", "nullable": false, "enum": ["observed", "not_estimable", "failed"]},
        "reason_code": {"dtype": "string", "nullable": true},
        "permutation_null_p_value": {"dtype": "float", "nullable": true, "minimum": 0.0, "maximum": 1.0},
        "n_hypotheses": {"dtype": "integer", "nullable": false, "minimum": 1}
      }
    }
  }
}
