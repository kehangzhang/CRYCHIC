{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crychic:schema:extension:specificity-support:1.0.0",
  "title": "CRYCHIC authenticated specificity-support table",
  "type": "object",
  "additionalProperties": false,
  "required": ["extension_schema_version", "result_schema_version", "table", "filename", "primary_key", "linked_tables", "columns"],
  "properties": {
    "extension_schema_version": {"const": "1.0.0"},
    "result_schema_version": {"const": "0.1.0"},
    "table": {"const": "specificity_support"},
    "filename": {"const": "specificity_support.parquet"},
    "primary_key": {"const": ["hypothesis_level", "hypothesis_id", "contrast", "mode", "view"]},
    "linked_tables": {"const": ["differential"]},
    "columns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_level", "hypothesis_role", "hypothesis_id", "contrast", "mode", "view", "receiver", "family_id",
        "specificity_support", "status", "reason_code", "minimum_effect", "specificity_direction", "specificity_semantics", "minimum_bootstraps",
        "n_bootstrap_total", "n_bootstrap_observed", "n_bootstrap_not_estimable", "n_bootstrap_failed",
        "result_id", "target_id", "score_target_id", "declaration_id", "hypothesis_universe_id", "effect_scale_id",
        "point_crossfit_id", "crossfit_spec_id", "point_effect_result_id", "bootstrap_source_binding_id", "bootstrap_plan_set_id",
        "effect_spec_id", "distribution_spec_id", "source_distribution_id", "specificity_support_spec_id", "numeric_result_id",
        "source_authenticated", "source_binding_status", "authentication_semantics", "specificity_support_release_allowed",
        "formal_pq_inference_allowed", "is_posterior_probability", "is_comm_probability"
      ],
      "properties": {
        "hypothesis_level": {"dtype": "string", "nullable": false, "enum": ["driver_family_receiver"], "unit": null, "description": "Family-by-receiver differential hypothesis"},
        "hypothesis_role": {"dtype": "string", "nullable": false, "enum": ["secondary"], "unit": null, "description": "Hierarchical hypothesis role"},
        "hypothesis_id": {"$ref": "#/$defs/stringRequired"},
        "contrast": {"$ref": "#/$defs/stringRequired"},
        "mode": {"dtype": "string", "nullable": false, "enum": ["state"], "unit": null, "description": "Released v1 specificity estimand"},
        "view": {"dtype": "string", "nullable": false, "enum": ["gene"], "unit": null, "description": "Released v1 response view"},
        "receiver": {"$ref": "#/$defs/stringRequired"},
        "family_id": {"$ref": "#/$defs/stringRequired"},
        "specificity_support": {"$ref": "#/$defs/unitIntervalNullable"},
        "status": {"$ref": "#/$defs/supportStatus"},
        "reason_code": {"$ref": "#/$defs/stringNullable"},
        "minimum_effect": {"$ref": "#/$defs/nonnegativeFloatNullable"},
        "specificity_direction": {"$ref": "#/$defs/specificityDirectionNullable"},
        "specificity_semantics": {"$ref": "#/$defs/stringRequired"},
        "minimum_bootstraps": {"dtype": "integer", "nullable": false, "minimum": 1000, "maximum": 1000, "unit": "bootstrap plans", "description": "Fixed minimum plan count"},
        "n_bootstrap_total": {"$ref": "#/$defs/count"},
        "n_bootstrap_observed": {"$ref": "#/$defs/count"},
        "n_bootstrap_not_estimable": {"$ref": "#/$defs/count"},
        "n_bootstrap_failed": {"$ref": "#/$defs/count"},
        "result_id": {"$ref": "#/$defs/stringRequired"},
        "target_id": {"$ref": "#/$defs/stringNullable"},
        "score_target_id": {"$ref": "#/$defs/stringNullable"},
        "declaration_id": {"$ref": "#/$defs/stringRequired"},
        "hypothesis_universe_id": {"$ref": "#/$defs/stringRequired"},
        "effect_scale_id": {"$ref": "#/$defs/stringNullable"},
        "point_crossfit_id": {"$ref": "#/$defs/stringRequired"},
        "crossfit_spec_id": {"$ref": "#/$defs/stringRequired"},
        "point_effect_result_id": {"$ref": "#/$defs/stringNullable"},
        "bootstrap_source_binding_id": {"$ref": "#/$defs/stringNullable"},
        "bootstrap_plan_set_id": {"$ref": "#/$defs/stringNullable"},
        "effect_spec_id": {"$ref": "#/$defs/stringNullable"},
        "distribution_spec_id": {"$ref": "#/$defs/stringNullable"},
        "source_distribution_id": {"$ref": "#/$defs/stringNullable"},
        "specificity_support_spec_id": {"$ref": "#/$defs/stringNullable"},
        "numeric_result_id": {"$ref": "#/$defs/stringNullable"},
        "source_authenticated": {"$ref": "#/$defs/trueBoolean"},
        "source_binding_status": {"$ref": "#/$defs/stringRequired"},
        "authentication_semantics": {"$ref": "#/$defs/stringRequired"},
        "specificity_support_release_allowed": {"dtype": "boolean", "nullable": false, "unit": null, "description": "Component-specific release decision"},
        "formal_pq_inference_allowed": {"$ref": "#/$defs/falseBoolean"},
        "is_posterior_probability": {"$ref": "#/$defs/falseBoolean"},
        "is_comm_probability": {"$ref": "#/$defs/falseBoolean"}
      }
    }
  },
  "$defs": {
    "stringRequired": {"dtype": "string", "nullable": false, "unit": null, "description": "Stable non-empty value"},
    "stringNullable": {"dtype": "string", "nullable": true, "unit": null, "description": "Optional reason"},
    "unitIntervalNullable": {"dtype": "float", "nullable": true, "minimum": 0.0, "maximum": 1.0, "unit": "frequency", "description": "Frequentist exceedance frequency"},
    "nonnegativeFloatNullable": {"dtype": "float", "nullable": true, "minimum": 0.0, "unit": "effect scale", "description": "Pre-registered minimum effect when an applicable specification exists"},
    "specificityDirectionNullable": {"dtype": "string", "nullable": true, "enum": ["greater", "less", "two_sided"], "unit": null, "description": "Pre-registered exceedance direction when an applicable specification exists"},
    "count": {"dtype": "integer", "nullable": false, "minimum": 0, "unit": "rows", "description": "Non-negative count"},
    "supportStatus": {"dtype": "string", "nullable": false, "enum": ["observed", "not_estimable", "failed"], "unit": null, "description": "Component availability"},
    "trueBoolean": {"dtype": "boolean", "nullable": false, "enum": [true], "unit": null, "description": "Must be true"},
    "falseBoolean": {"dtype": "boolean", "nullable": false, "enum": [false], "unit": null, "description": "Must be false"}
  }
}
