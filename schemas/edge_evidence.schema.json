{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crychic:schema:extension:edge-evidence:1.0.0",
  "title": "CRYCHIC edge-evidence result extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["extension_schema_version", "result_schema_version", "table", "filename", "primary_key", "linked_tables", "columns"],
  "properties": {
    "extension_schema_version": {"const": "1.0.0"},
    "result_schema_version": {"const": "0.1.0"},
    "table": {"const": "edge_evidence"},
    "filename": {"const": "edge_evidence.parquet"},
    "primary_key": {
      "const": ["contrast", "fold_id", "sample_id", "context_id", "sender", "receiver", "interaction_id", "mode"]
    },
    "linked_tables": {"const": ["sample_scores"]},
    "columns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id", "subject_id", "context", "context_id", "sender", "receiver", "interaction_id", "driver_id", "mode", "contrast", "fold_id",
        "state_availability", "state_availability_status", "state_availability_reason_code",
        "ecosystem_availability", "ecosystem_availability_status", "ecosystem_availability_reason_code",
        "receptor_gate", "receptor_gate_status", "receptor_gate_reason_code",
        "receiver_program_score", "receiver_program_status", "receiver_program_reason_code",
        "incremental_downstream", "incremental_downstream_status", "incremental_downstream_reason_code",
        "attribution_support", "attribution_support_method", "attribution_support_status", "attribution_support_reason_code",
        "sender_weight", "sender_status", "sender_reason_code",
        "prior_quality", "prior_quality_source", "prior_quality_status", "prior_quality_reason_code",
        "legacy_downstream_activity", "legacy_downstream_status", "legacy_downstream_reason_code",
        "legacy_integrated_strength", "legacy_integrated_status", "legacy_integrated_reason_code",
        "scoring_function_status", "scoring_function_reason_code", "score_version", "model_manifest_id", "scoring_function_id",
        "sample_score_status", "sample_score_reason_code"
      ],
      "properties": {
        "sample_id": {"$ref": "#/$defs/stringRequired"},
        "subject_id": {"$ref": "#/$defs/stringRequired"},
        "context": {"$ref": "#/$defs/stringRequired"},
        "context_id": {"$ref": "#/$defs/stringRequired"},
        "sender": {"$ref": "#/$defs/stringRequired"},
        "receiver": {"$ref": "#/$defs/stringRequired"},
        "interaction_id": {"$ref": "#/$defs/stringRequired"},
        "driver_id": {"$ref": "#/$defs/stringNullable"},
        "mode": {"$ref": "#/$defs/mode"},
        "contrast": {"$ref": "#/$defs/stringRequired"},
        "fold_id": {"$ref": "#/$defs/stringRequired"},
        "state_availability": {"$ref": "#/$defs/unitIntervalNullable"},
        "state_availability_status": {"$ref": "#/$defs/stringRequired"},
        "state_availability_reason_code": {"$ref": "#/$defs/stringNullable"},
        "ecosystem_availability": {"$ref": "#/$defs/unitIntervalNullable"},
        "ecosystem_availability_status": {"$ref": "#/$defs/stringRequired"},
        "ecosystem_availability_reason_code": {"$ref": "#/$defs/stringNullable"},
        "receptor_gate": {"$ref": "#/$defs/unitIntervalNullable"},
        "receptor_gate_status": {"$ref": "#/$defs/stringRequired"},
        "receptor_gate_reason_code": {"$ref": "#/$defs/stringNullable"},
        "receiver_program_score": {"$ref": "#/$defs/unitIntervalNullable"},
        "receiver_program_status": {"$ref": "#/$defs/stringRequired"},
        "receiver_program_reason_code": {"$ref": "#/$defs/stringNullable"},
        "incremental_downstream": {"$ref": "#/$defs/unitIntervalNullable"},
        "incremental_downstream_status": {"$ref": "#/$defs/stringRequired"},
        "incremental_downstream_reason_code": {"$ref": "#/$defs/stringNullable"},
        "attribution_support": {"$ref": "#/$defs/unitIntervalNullable"},
        "attribution_support_method": {"$ref": "#/$defs/stringRequired"},
        "attribution_support_status": {"$ref": "#/$defs/stringRequired"},
        "attribution_support_reason_code": {"$ref": "#/$defs/stringNullable"},
        "sender_weight": {"$ref": "#/$defs/unitIntervalNullable"},
        "sender_status": {"$ref": "#/$defs/stringRequired"},
        "sender_reason_code": {"$ref": "#/$defs/stringNullable"},
        "prior_quality": {"$ref": "#/$defs/unitIntervalNullable"},
        "prior_quality_source": {"$ref": "#/$defs/stringNullable"},
        "prior_quality_status": {"$ref": "#/$defs/stringRequired"},
        "prior_quality_reason_code": {"$ref": "#/$defs/stringNullable"},
        "legacy_downstream_activity": {"$ref": "#/$defs/unitIntervalNullable"},
        "legacy_downstream_status": {"$ref": "#/$defs/stringRequired"},
        "legacy_downstream_reason_code": {"$ref": "#/$defs/stringNullable"},
        "legacy_integrated_strength": {"$ref": "#/$defs/unitIntervalNullable"},
        "legacy_integrated_status": {"$ref": "#/$defs/stringRequired"},
        "legacy_integrated_reason_code": {"$ref": "#/$defs/stringNullable"},
        "scoring_function_status": {"$ref": "#/$defs/stringRequired"},
        "scoring_function_reason_code": {"$ref": "#/$defs/stringNullable"},
        "score_version": {"$ref": "#/$defs/stringNullable"},
        "model_manifest_id": {"$ref": "#/$defs/stringNullable"},
        "scoring_function_id": {"$ref": "#/$defs/stringNullable"},
        "sample_score_status": {"dtype": "string", "nullable": false, "enum": ["linked", "not_emitted"], "unit": null, "description": "Whether this ledger row has a sample_scores row"},
        "sample_score_reason_code": {"$ref": "#/$defs/stringNullable"}
      }
    }
  },
  "$defs": {
    "stringRequired": {"dtype": "string", "nullable": false, "unit": null, "description": "Stable non-null value"},
    "stringNullable": {"dtype": "string", "nullable": true, "unit": null, "description": "Optional value or reason"},
    "unitIntervalNullable": {"dtype": "float", "nullable": true, "minimum": 0.0, "maximum": 1.0, "unit": "proportion", "description": "Nullable evidence component"},
    "mode": {"dtype": "string", "nullable": false, "enum": ["state", "ecosystem"], "unit": null, "description": "Communication estimand"}
  }
}
