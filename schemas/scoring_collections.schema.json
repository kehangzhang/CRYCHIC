{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crychic:schema:extension:scoring-collections:1.0.0",
  "title": "CRYCHIC receiver scoring collections extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extension_schema_version",
    "result_schema_version",
    "collection_kind",
    "digest_method",
    "collections"
  ],
  "properties": {
    "extension_schema_version": {"const": "1.0.0"},
    "result_schema_version": {"const": "0.1.0"},
    "collection_kind": {"const": "receiver_partition"},
    "digest_method": {"const": "sha256_canonical_csv_v1"},
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/collection"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_manifest_id",
        "receiver",
        "scoring_functional_id",
        "provenance_status",
        "source_score_key_digest",
        "source_score_row_count"
      ],
      "properties": {
        "child_manifest_id": {"$ref": "#/$defs/identifier"},
        "receiver": {"$ref": "#/$defs/identifier"},
        "scoring_functional_id": {"$ref": "#/$defs/identifier"},
        "provenance_status": {
          "const": "functional_metadata_not_persisted_unverified"
        },
        "source_score_key_digest": {"$ref": "#/$defs/sha256"},
        "source_score_row_count": {"type": "integer", "minimum": 1}
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scoring_collection_id",
        "contrast",
        "repeat_id",
        "fold_id",
        "partition_key",
        "receiver_scope",
        "composition_status",
        "common_functional_across_receivers",
        "emitted_receivers",
        "children",
        "source_score_key_digest",
        "source_score_row_count"
      ],
      "properties": {
        "scoring_collection_id": {"$ref": "#/$defs/identifier"},
        "contrast": {"$ref": "#/$defs/identifier"},
        "repeat_id": {"$ref": "#/$defs/identifier"},
        "fold_id": {"$ref": "#/$defs/identifier"},
        "partition_key": {"const": "receiver"},
        "receiver_scope": {"const": "emitted_sample_scores"},
        "composition_status": {"const": "partial_emitted_only"},
        "common_functional_across_receivers": {"const": false},
        "emitted_receivers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/child"}
        },
        "source_score_key_digest": {"$ref": "#/$defs/sha256"},
        "source_score_row_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
