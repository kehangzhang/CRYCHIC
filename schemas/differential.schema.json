{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crychic:schema:table:differential:0.1.0",
  "title": "CRYCHIC v0.1 differential diagnostics table",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_schema_version", "table", "filename", "primary_key", "columns", "inferential_null_columns", "reason_required_for_null_columns"],
  "properties": {
    "result_schema_version": {"const": "0.1.0"},
    "table": {"const": "differential"},
    "filename": {"const": "differential.parquet"},
    "primary_key": {
      "const": ["hypothesis_level", "hypothesis_id", "contrast", "mode", "view"]
    },
    "inferential_null_columns": {
      "const": ["p_value", "q_value", "specificity_support"]
    },
    "reason_required_for_null_columns": {
      "const": ["effect_size", "standard_error", "statistic", "p_value", "q_value", "specificity_support", "change_class"]
    },
    "columns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_level", "hypothesis_id", "contrast", "mode", "view", "effect_size", "standard_error", "statistic", "p_value", "q_value", "specificity_support", "change_class", "status", "reason_code"],
      "properties": {
        "hypothesis_level": {"$ref": "#/$defs/stringRequired"},
        "hypothesis_id": {"$ref": "#/$defs/stringRequired"},
        "contrast": {"$ref": "#/$defs/stringRequired"},
        "mode": {"$ref": "#/$defs/mode"},
        "view": {"dtype": "string", "nullable": false, "enum": ["gene", "tf", "pathway"], "unit": null, "description": "Response view"},
        "effect_size": {"$ref": "#/$defs/floatNullable"},
        "standard_error": {"$ref": "#/$defs/nonnegativeFloatNullable"},
        "statistic": {"$ref": "#/$defs/floatNullable"},
        "p_value": {"$ref": "#/$defs/unitIntervalNullable"},
        "q_value": {"$ref": "#/$defs/unitIntervalNullable"},
        "specificity_support": {"$ref": "#/$defs/unitIntervalNullable"},
        "change_class": {"dtype": "string", "nullable": true, "enum": ["state_driven", "abundance_driven", "mixed", "unstable", "not_classifiable"], "unit": null, "description": "Versioned state/ecosystem classification"},
        "status": {"$ref": "#/$defs/status"},
        "reason_code": {"dtype": "string", "nullable": false, "unit": null, "description": "v0.1 inferential-disable or row status reason"}
      }
    }
  },
  "$defs": {
    "stringRequired": {"dtype": "string", "nullable": false, "unit": null, "description": "Stable non-null identifier"},
    "floatNullable": {"dtype": "float", "nullable": true, "unit": null, "description": "Nullable diagnostic estimate"},
    "nonnegativeFloatNullable": {"dtype": "float", "nullable": true, "minimum": 0.0, "unit": null, "description": "Nullable non-negative diagnostic"},
    "unitIntervalNullable": {"dtype": "float", "nullable": true, "minimum": 0.0, "maximum": 1.0, "unit": "proportion", "description": "Disabled inferential field in v0.1"},
    "mode": {"dtype": "string", "nullable": false, "enum": ["state", "ecosystem"], "unit": null, "description": "Communication estimand"},
    "status": {"dtype": "string", "nullable": false, "enum": ["ok", "missing", "not_estimable", "filtered", "failed"], "unit": null, "description": "Explicit result status"}
  }
}
