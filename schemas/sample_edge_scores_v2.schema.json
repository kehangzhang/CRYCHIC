{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crychic:schema:table:sample-edge-scores:2.0.0",
  "title": "CRYCHIC v2 sample-level edge scores",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_schema_version", "table", "filename", "primary_key", "columns"],
  "properties": {
    "artifact_schema_version": {"const": "2.0.0"},
    "table": {"const": "sample_edge_scores_v2"},
    "filename": {"const": "sample_edge_scores_v2.parquet"},
    "primary_key": {
      "const": ["sample_id", "context_id", "fold_id", "sender", "receiver", "interaction_id"]
    },
    "columns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id", "subject_id", "condition", "context_id", "fold_id",
        "sender", "receiver", "interaction_id", "ligand", "receptor",
        "ligand_activity_raw", "receptor_activity_raw", "sender_detection_raw",
        "parent_peak_raw", "parent_total_raw", "parent_mean_raw",
        "program_signed", "program_status", "program_reason_code",
        "program_functional_id",
        "mechanism_support", "coupling_prior", "coupling_status",
        "coupling_reason_code", "coupling_functional_id", "active_probability",
        "occurrence_status", "occurrence_reason_code", "occurrence_functional_id",
        "sender_attribution", "null_sender_attribution", "attribution_status",
        "attribution_reason_code", "attribution_functional_id", "cell_count_reliability",
        "reliability_weight", "candidate_sender_count", "effective_candidate_count",
        "coverage_status", "structural_impossibility", "selection_stability",
        "status", "reason_code", "score_version", "activity_functional_id",
        "out_of_fold", "provenance"
      ],
      "properties": {
        "sample_id": {"$ref": "#/$defs/stringRequired"},
        "subject_id": {"$ref": "#/$defs/stringRequired"},
        "condition": {"$ref": "#/$defs/stringRequired"},
        "context_id": {"$ref": "#/$defs/stringRequired"},
        "fold_id": {"$ref": "#/$defs/stringRequired"},
        "sender": {"$ref": "#/$defs/stringRequired"},
        "receiver": {"$ref": "#/$defs/stringRequired"},
        "interaction_id": {"$ref": "#/$defs/stringRequired"},
        "ligand": {"$ref": "#/$defs/stringRequired"},
        "receptor": {"$ref": "#/$defs/stringRequired"},
        "ligand_activity_raw": {"$ref": "#/$defs/nonnegativeNullable"},
        "receptor_activity_raw": {"$ref": "#/$defs/nonnegativeNullable"},
        "sender_detection_raw": {"$ref": "#/$defs/nonnegativeNullable"},
        "parent_peak_raw": {"$ref": "#/$defs/nonnegativeNullable"},
        "parent_total_raw": {"$ref": "#/$defs/nonnegativeNullable"},
        "parent_mean_raw": {"$ref": "#/$defs/nonnegativeNullable"},
        "program_signed": {"$ref": "#/$defs/floatNullable"},
        "program_status": {"$ref": "#/$defs/headStatus"},
        "program_reason_code": {"$ref": "#/$defs/stringNullable"},
        "program_functional_id": {"$ref": "#/$defs/stringNullable"},
        "mechanism_support": {"$ref": "#/$defs/unitIntervalNullable"},
        "coupling_prior": {"$ref": "#/$defs/signedUnitNullable"},
        "coupling_status": {"$ref": "#/$defs/headStatus"},
        "coupling_reason_code": {"$ref": "#/$defs/stringNullable"},
        "coupling_functional_id": {"$ref": "#/$defs/stringNullable"},
        "active_probability": {"$ref": "#/$defs/unitIntervalNullable"},
        "occurrence_status": {"$ref": "#/$defs/headStatus"},
        "occurrence_reason_code": {"$ref": "#/$defs/stringNullable"},
        "occurrence_functional_id": {"$ref": "#/$defs/stringNullable"},
        "sender_attribution": {"$ref": "#/$defs/unitIntervalNullable"},
        "null_sender_attribution": {"$ref": "#/$defs/unitIntervalNullable"},
        "attribution_status": {"$ref": "#/$defs/headStatus"},
        "attribution_reason_code": {"$ref": "#/$defs/stringNullable"},
        "attribution_functional_id": {"$ref": "#/$defs/stringNullable"},
        "cell_count_reliability": {"$ref": "#/$defs/unitIntervalNullable"},
        "reliability_weight": {"$ref": "#/$defs/unitIntervalNullable"},
        "candidate_sender_count": {"$ref": "#/$defs/positiveInteger"},
        "effective_candidate_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "coverage_status": {"$ref": "#/$defs/coverageStatus"},
        "structural_impossibility": {"$ref": "#/$defs/booleanRequired"},
        "selection_stability": {"$ref": "#/$defs/unitIntervalNullable"},
        "status": {"$ref": "#/$defs/valueStatus"},
        "reason_code": {"$ref": "#/$defs/stringNullable"},
        "score_version": {"$ref": "#/$defs/stringRequired"},
        "activity_functional_id": {"$ref": "#/$defs/stringRequired"},
        "out_of_fold": {"$ref": "#/$defs/booleanRequired"},
        "provenance": {"$ref": "#/$defs/stringRequired"}
      }
    }
  },
  "$defs": {
    "stringRequired": {"dtype": "string", "nullable": false, "unit": null},
    "stringNullable": {"dtype": "string", "nullable": true, "unit": null},
    "floatNullable": {"dtype": "float", "nullable": true, "unit": "latent_score"},
    "nonnegativeNullable": {"dtype": "float", "nullable": true, "minimum": 0.0, "unit": "log2_normalized_expression"},
    "unitIntervalNullable": {"dtype": "float", "nullable": true, "minimum": 0.0, "maximum": 1.0, "unit": "proportion"},
    "signedUnitNullable": {"dtype": "float", "nullable": true, "minimum": -1.0, "maximum": 1.0, "unit": "correlation"},
    "positiveInteger": {"dtype": "integer", "nullable": false, "minimum": 1, "unit": "candidate"},
    "nonnegativeInteger": {"dtype": "integer", "nullable": false, "minimum": 0, "unit": "candidate"},
    "booleanRequired": {"dtype": "boolean", "nullable": false, "unit": null},
    "headStatus": {"dtype": "string", "nullable": false, "enum": ["observed", "partial", "not_estimable", "not_computed"], "unit": null},
    "coverageStatus": {"dtype": "string", "nullable": false, "enum": ["measured", "low_coverage", "structural_impossible", "not_measured_or_not_estimable"], "unit": null},
    "valueStatus": {"dtype": "string", "nullable": false, "enum": ["observed", "low_evidence", "structural_impossible", "not_estimable"], "unit": null}
  }
}
