{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crychic:schema:result:g3p-calibration:2.0.0",
  "title": "CRYCHIC independent ADR-013 G3-P calibration campaign artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_schema_version",
    "artifact_kind",
    "artifact_id",
    "status",
    "campaign_schema_version",
    "campaign_id",
    "protocol_id",
    "evidence_id",
    "gate_id",
    "gate_status",
    "comm_probability_release_allowed",
    "replicate_ids",
    "scenario_result_ids",
    "protocol",
    "evidence",
    "calibration_gate",
    "generator_attestation",
    "tables"
  ],
  "properties": {
    "artifact_schema_version": {"const": "2.0.0"},
    "artifact_kind": {"const": "adr013_g3p_calibration_result"},
    "artifact_id": {"type": "string", "minLength": 1},
    "status": {"const": "complete"},
    "campaign_schema_version": {"const": "3.0.0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "protocol_id": {"type": "string", "minLength": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "gate_id": {"type": "string", "minLength": 1},
    "gate_status": {"enum": ["passed", "failed", "not_estimable"]},
    "comm_probability_release_allowed": {"type": "boolean"},
    "replicate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "scenario_result_ids": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "protocol": {"type": "object"},
    "evidence": {"type": "object"},
    "calibration_gate": {"type": "object"},
    "generator_attestation": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/generatorAttestation"}
      ]
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "g3p_calibration_replicates",
        "g3p_calibration_candidates",
        "g3p_calibration_scenarios"
      ],
      "properties": {
        "g3p_calibration_replicates": {"$ref": "#/$defs/tableRecord"},
        "g3p_calibration_candidates": {"$ref": "#/$defs/tableRecord"},
        "g3p_calibration_scenarios": {"$ref": "#/$defs/tableRecord"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"gate_status": {"const": "passed"}},
        "required": ["gate_status"]
      },
      "then": {
        "properties": {"comm_probability_release_allowed": {"const": true}}
      },
      "else": {
        "properties": {"comm_probability_release_allowed": {"const": false}}
      }
    }
  ],
  "$defs": {
    "generatorAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_id",
        "campaign_kind",
        "protocol_id",
        "generator_id",
        "registry_id",
        "generator_config_digest",
        "generator_implementation_digest",
        "generator_code_version",
        "release_approved",
        "replicate_ids",
        "request_ids",
        "ledger_digest",
        "replayed_ledger_digest",
        "schema_version"
      ],
      "properties": {
        "attestation_id": {"type": "string", "minLength": 1},
        "campaign_kind": {"const": "g3_probability"},
        "protocol_id": {"type": "string", "minLength": 1},
        "generator_id": {"type": "string", "minLength": 1},
        "registry_id": {"type": "string", "minLength": 1},
        "generator_config_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generator_implementation_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generator_code_version": {"type": "string", "minLength": 1},
        "release_approved": {"type": "boolean"},
        "replicate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "request_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "ledger_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "replayed_ledger_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_version": {"const": "1.0.0"}
      }
    },
    "tableRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "rows", "sha256", "schema"],
      "properties": {
        "filename": {"type": "string", "pattern": "^[a-z0-9_]+\\.parquet$"},
        "rows": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema": {"type": "string", "pattern": "^[a-z0-9_]+\\.schema\\.json$"}
      }
    }
  }
}
