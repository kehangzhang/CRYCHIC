{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crychic:schema:table:sample-scores:0.1.0",
  "title": "CRYCHIC v0.1 sample scores table",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_schema_version", "table", "filename", "primary_key", "columns", "inferential_null_columns", "reason_required_for_null_columns"],
  "properties": {
    "result_schema_version": {"const": "0.1.0"},
    "table": {"const": "sample_scores"},
    "filename": {"const": "sample_scores.parquet"},
    "primary_key": {
      "const": ["subject_id", "sample_id", "context_id", "design_row_id", "edge_id", "scoring_functional_id", "repeat_id", "fold_id", "mode"]
    },
    "inferential_null_columns": {"const": []},
    "reason_required_for_null_columns": {
      "const": ["availability", "downstream", "sender_component", "prior_quality", "abundance_component", "comm_strength"]
    },
    "columns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "sample_id", "context_id", "context_json", "design_row_id", "edge_id", "scoring_functional_id", "repeat_id", "fold_id", "mode", "availability", "downstream", "sender_component", "prior_quality", "abundance_component", "comm_strength", "eligible", "status", "reason_code"],
      "properties": {
        "subject_id": {"$ref": "#/$defs/stringRequired"},
        "sample_id": {"$ref": "#/$defs/stringRequired"},
        "context_id": {"$ref": "#/$defs/stringRequired"},
        "context_json": {"$ref": "#/$defs/stringRequired"},
        "design_row_id": {"$ref": "#/$defs/stringRequired"},
        "edge_id": {"$ref": "#/$defs/stringRequired"},
        "scoring_functional_id": {"$ref": "#/$defs/stringRequired"},
        "repeat_id": {"$ref": "#/$defs/stringRequired"},
        "fold_id": {"$ref": "#/$defs/stringRequired"},
        "mode": {"$ref": "#/$defs/mode"},
        "availability": {"$ref": "#/$defs/unitIntervalNullable"},
        "downstream": {"$ref": "#/$defs/unitIntervalNullable"},
        "sender_component": {"$ref": "#/$defs/unitIntervalNullable"},
        "prior_quality": {"$ref": "#/$defs/unitIntervalNullable"},
        "abundance_component": {"$ref": "#/$defs/unitIntervalNullable"},
        "comm_strength": {"$ref": "#/$defs/unitIntervalNullable"},
        "eligible": {"dtype": "boolean", "nullable": false, "unit": null, "description": "Whether the sample score is eligible"},
        "status": {"$ref": "#/$defs/status"},
        "reason_code": {"dtype": "string", "nullable": true, "unit": null, "description": "Missingness or eligibility reason"}
      }
    }
  },
  "$defs": {
    "stringRequired": {"dtype": "string", "nullable": false, "unit": null, "description": "Stable non-null identifier"},
    "unitIntervalNullable": {"dtype": "float", "nullable": true, "minimum": 0.0, "maximum": 1.0, "unit": "proportion", "description": "Nullable score component"},
    "mode": {"dtype": "string", "nullable": false, "enum": ["state", "ecosystem"], "unit": null, "description": "Communication estimand"},
    "status": {"dtype": "string", "nullable": false, "enum": ["ok", "missing", "not_estimable", "filtered", "failed"], "unit": null, "description": "Explicit result status"}
  }
}
